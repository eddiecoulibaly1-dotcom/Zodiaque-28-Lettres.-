rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
        'label', 'name', 'birthDate', 'birthTime', 'timeZone',
        'latitude', 'longitude', 'place', 'calculationSnapshot',
        'notes', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasAll([
        'label', 'name', 'birthDate', 'birthTime', 'timeZone',
        'latitude', 'longitude', 'place', 'calculationSnapshot',
        'notes', 'createdAt', 'updatedAt'
      ])
      && data.label is string && data.label.size() > 0 && data.label.size() <= 100
      && data.name is string && data.name.size() <= 160
      && data.birthDate is string && data.birthDate.size() <= 10
      && data.birthTime is string && data.birthTime.size() <= 5
      && data.timeZone is string && data.timeZone.size() > 0 && data.timeZone.size() <= 80
      && (data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
      && (data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
      && data.place is string && data.place.size() <= 200
      && data.calculationSnapshot is map
      && data.notes is string && data.notes.size() <= 3000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /users/{uid}/profiles/{profileId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(request.resource.data);
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
